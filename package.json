{
  "name": "xroute-web",
  "version": "1.7.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "Ati054 <ati054@tutamail.com> (https://github.com/Ati054)",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node build/harden-dependencies.mjs",
    "predev": "node build/harden-dependencies.mjs",
    "dev": "vinext dev",
    "prebuild": "node build/harden-dependencies.mjs",
    "build": "node build/run-vinext-build.cjs",
    "prebuild:static": "node build/harden-dependencies.mjs",
    "build:static": "next build",
    "prestart": "node build/harden-dependencies.mjs",
    "start": "vinext start",
    "test:dependencies": "node --test tests/build-dependencies.test.mjs tests/braces-hardening.test.mjs",
    "audit:dependencies": "npm run test:dependencies && npm audit --audit-level=low",
    "test": "npm run build && npm run build:static && node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "node scripts/test-console-browser.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .tmp --ignore-pattern .cache-release"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.4.5",
    "vite": "8.3.8",
    "wrangler": "4.160.0"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "fast-uri": "3.1.9",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "fflate": "0.7.5",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "type": "module"
}
